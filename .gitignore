# Generated Xcode project — recreate with `xcodegen generate`
*.xcodeproj/

# Build output
.build/
.build-device/
build/
DerivedData/

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside

# Swift Package Manager
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Misc
*.swp
*~
*.log

# Agent handoff docs
*-handoff.md

# Claude Code runtime scratch (scheduled-task locks, etc.)
.claude/
# ...but vendor skills so they travel with the repo (e.g. coding from iPhone)
!.claude/
!.claude/skills/
!.claude/skills/**
.claude/worktrees/
.claude/*.lock

# Python bytecode in vendored skills
.claude/skills/**/__pycache__/
.claude/skills/**/*.pyc
