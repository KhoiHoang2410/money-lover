{
  "engine": "fx_fees",
  "description": "TransferEngine / TransferFxMath: the fee of a cross-currency transfer between the owner's own sources, in the destination currency. fee = (amount_out_in_major_units x rate) - amount_in, where rate is destination major units per one source major unit. A positive fee is value lost to spread; a favorable rate yields a negative fee. The native amounts move whole: the source loses amount_out, the destination gains amount_in (the destination_amount). Money is integer minor units; convert minor->major with the currency minor-unit scale (VND=1, SGD=100, USD=100 minor units per major unit). rate is an exact decimal carried as a number.",
  "source_swift_tests": [
    "ios/MoneyLoverTests/TransferEngineTests.swift"
  ],
  "cases": [
    {
      "name": "fee_is_expected_minus_received",
      "method": "fee",
      "inputs": {
        "amount_out": { "minor_units": 60000, "currency": "SGD" },
        "amount_in": { "minor_units": 10950000, "currency": "VND" },
        "rate": 18500
      },
      "expected_outputs": { "fee": { "minor_units": 150000, "currency": "VND" } }
    },
    {
      "name": "zero_fee_when_rate_matches",
      "method": "fee",
      "inputs": {
        "amount_out": { "minor_units": 100, "currency": "USD" },
        "amount_in": { "minor_units": 25500, "currency": "VND" },
        "rate": 25500
      },
      "expected_outputs": { "fee": { "minor_units": 0, "currency": "VND" } }
    },
    {
      "name": "negative_fee_when_received_exceeds_expected",
      "method": "fee",
      "inputs": {
        "amount_out": { "minor_units": 10000, "currency": "SGD" },
        "amount_in": { "minor_units": 1900000, "currency": "VND" },
        "rate": 18500
      },
      "expected_outputs": { "fee": { "minor_units": -50000, "currency": "VND" } }
    },
    {
      "name": "cross_currency_transfer_moves_native_amounts",
      "method": "transfer_balances",
      "inputs": {
        "source": { "id": "wise", "kind": "account", "currency": "SGD", "opening_balance": { "minor_units": 240000, "currency": "SGD" } },
        "destination": { "id": "vpbank", "kind": "account", "currency": "VND", "opening_balance": { "minor_units": 12500000, "currency": "VND" } },
        "transaction": {
          "kind": "transfer",
          "amount": { "minor_units": 60000, "currency": "SGD" },
          "source_id": "wise",
          "destination_id": "vpbank",
          "destination_amount": { "minor_units": 10950000, "currency": "VND" }
        }
      },
      "expected_outputs": {
        "source_balance": { "minor_units": 180000, "currency": "SGD" },
        "destination_balance": { "minor_units": 23450000, "currency": "VND" }
      }
    },
    {
      "name": "pay_card_reduces_account_and_debt",
      "method": "transfer_balances",
      "inputs": {
        "source": { "id": "acc", "kind": "account", "currency": "VND", "opening_balance": { "minor_units": 80000000, "currency": "VND" } },
        "destination": { "id": "card", "kind": "credit_card", "currency": "VND", "opening_balance": { "minor_units": -18300000, "currency": "VND" } },
        "transaction": {
          "kind": "transfer",
          "amount": { "minor_units": 18300000, "currency": "VND" },
          "source_id": "acc",
          "destination_id": "card"
        }
      },
      "expected_outputs": {
        "source_balance": { "minor_units": 61700000, "currency": "VND" },
        "destination_balance": { "minor_units": 0, "currency": "VND" }
      }
    }
  ]
}
